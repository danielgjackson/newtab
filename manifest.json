{
  "name": "Blank new tab page",
  "description": "Overrides the new tab page, home page, and startup pages to be blank",
  "version": "0.2",
  "incognito": "split",
  "chrome_url_overrides": {
    "newtab": "blank.html"
  },
  "chrome_settings_overrides" : {
    "startup_pages": [
      "about:blank"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["blank.html", "blank.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "settings.html"
  },
  "manifest_version": 3
}
