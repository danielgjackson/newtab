{
  "name": "Override new tab",
  "description": "Overrides the new tab page and home page on organisation-managed browsers where they cannot be changed.",
  "version": "0.5",
  "incognito": "split",
  "chrome_url_overrides": {
    "newtab": "redirected.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "webNavigation",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["redirected.html", "redirected.js", "common.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "settings.html"
  },
  "manifest_version": 3
}
